<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VibeSkuaX.App.Features.Shell"
        xmlns:controls="using:VibeSkuaX.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="VibeSkuaX.App.Features.Shell.ShellWindow"
        x:DataType="local:ShellViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="#131313" FontFamily="Segoe UI">
  <Window.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#C8C8C8" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#343434" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="40,*">
    <Border Name="TitleBar" Grid.Row="0" Background="#1D1D1D" BorderBrush="#303030" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <Border Name="TitleDragArea" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0,16,0">
            <Border Width="22" Height="22" CornerRadius="6" Background="#56C9F5" VerticalAlignment="Center">
              <TextBlock Text="X" Foreground="#11212A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#EEEEEE" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Name="StatusText" Grid.Column="3" Text="{Binding Status}" Foreground="#9E9E9E" FontSize="11" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Name="MinimizeButton" Classes="caption" Content="&#xE921;" Click="MinimizeClicked" chrome:WindowDecorationProperties.ElementRole="MinimizeButton" AutomationProperties.Name="Minimize" ToolTip.Tip="Minimize" />
          <Button Name="MaximizeButton" Classes="caption" Content="&#xE922;" Click="MaximizeClicked" chrome:WindowDecorationProperties.ElementRole="MaximizeButton" AutomationProperties.Name="Maximize or restore" ToolTip.Tip="Maximize or restore" />
          <Button Name="CloseButton" Classes="caption close" Content="&#xE8BB;" Click="CloseClicked" chrome:WindowDecorationProperties.ElementRole="CloseButton" AutomationProperties.Name="Close" ToolTip.Tip="Close" />
        </StackPanel>
      </Grid>
    </Border>
    <controls:FlashViewport Grid.Row="1" Name="GameViewport" IsVisible="{Binding !HasError}" />
    <StackPanel Name="GameErrorPanel" Grid.Row="1" IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="36" Spacing="12">
      <TextBlock Text="The game could not start" Foreground="#EEEEEE" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
      <TextBlock Name="GameErrorMessage" Text="{Binding ErrorMessage}" Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
