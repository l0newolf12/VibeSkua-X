<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VibeSkuaX.App.Features.Shell"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:controls="using:VibeSkuaX.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="VibeSkuaX.App.Features.Shell.ShellWindow"
        x:DataType="local:ShellViewModel"
        Classes="vsx-shell"
        Title="{Binding Title}"
        Width="1100" Height="672" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Grid Name="ShellLayout" RowDefinitions="Auto,*">
    <controls:WindowTitleBar Name="WindowChrome" Grid.Row="0">
      <controls:WindowTitleBar.HeaderContent>
        <ui:FATabView Name="AccountTabs" Classes="vsx-accounts"
                      TabItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                      AddTabButtonCommand="{Binding OpenGameCommand}" TabCloseRequested="TabCloseRequested"
                      CanReorderTabs="False" CanDragTabs="False" AllowDropTabs="False"
                      CloseButtonOverlayMode="Always" TabWidthMode="Equal"
                      chrome:WindowDecorationProperties.ElementRole="User">
          <ui:FATabView.TabStripHeader>
            <Border Padding="{StaticResource VsPaddingTitle}">
              <Border Classes="vsx-brand" VerticalAlignment="Center">
                <TextBlock Text="X" Classes="vsx-brand" />
              </Border>
            </Border>
          </ui:FATabView.TabStripHeader>
          <ui:FATabView.TabStripFooter>
            <Border Name="TitleDragArea" MinWidth="{StaticResource VsWidthTitleDrag}" Background="Transparent"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
              <TextBlock Name="StatusText" Classes="vsx-status" Text="{Binding Status}"
                         Margin="{StaticResource VsPaddingTitle}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Border>
          </ui:FATabView.TabStripFooter>
          <ui:FATabView.TabItemTemplate>
            <DataTemplate x:DataType="local:GameTabViewModel">
              <ui:FATabViewItem Header="{Binding}" ToolTip.Tip="{Binding AccessibleName}"
                                AutomationProperties.Name="{Binding AccessibleName}">
                <ui:FATabViewItem.HeaderTemplate>
                  <DataTemplate x:DataType="local:GameTabViewModel">
                    <Grid ColumnDefinitions="Auto,*">
                      <Ellipse Classes="vsx-game-state" Classes.loading="{Binding IsLoading}" Classes.failed="{Binding HasError}"
                               Width="{StaticResource VsSizeStatusDot}" Height="{StaticResource VsSizeStatusDot}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="{StaticResource VsMarginAfterIcon}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ui:FATabViewItem.HeaderTemplate>
              </ui:FATabViewItem>
            </DataTemplate>
          </ui:FATabView.TabItemTemplate>
        </ui:FATabView>
      </controls:WindowTitleBar.HeaderContent>
    </controls:WindowTitleBar>
    <StackPanel Name="GameErrorPanel" Grid.Row="1" IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="{StaticResource VsWidthMessage}" Margin="{StaticResource VsMarginMessage}" Spacing="{StaticResource VsSpace3}">
      <TextBlock Text="Game unavailable" Classes="vsx-heading" TextAlignment="Center" />
      <TextBlock Name="GameErrorMessage" Text="{Binding ErrorMessage}" Classes="vsx-body" TextWrapping="Wrap" TextAlignment="Center" />
      <Button Name="RetryGameButton" Content="Retry" Command="{Binding SelectedTab.RetryCommand}" Classes="vsx-dialog-action" HorizontalAlignment="Center" />
    </StackPanel>
    <StackPanel Name="NoGamesPanel" Grid.Row="1" IsVisible="{Binding HasNoTabs}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource VsSpace4}">
      <TextBlock Text="No games open" Classes="vsx-heading" />
      <Button Name="OpenGameButton" Content="Open game" Command="{Binding OpenGameCommand}" Classes="vsx-dialog-action" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
